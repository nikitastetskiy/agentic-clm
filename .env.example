# Copy to `.env` and fill in. NEVER commit your real .env (it is gitignored).

# --- Required: Copilot CLI authentication ---------------------------------------------
# Fine-grained personal access token with the "Copilot Requests" permission.
# Create at: https://github.com/settings/personal-access-tokens/new (Resource owner = your
# personal account; add Account permission "Copilot Requests"). Precedence: COPILOT_GITHUB_TOKEN
# > GH_TOKEN > GITHUB_TOKEN.
COPILOT_GITHUB_TOKEN=

# --- Optional: raise GitHub API rate limits for the skill-updater ---------------------
# Any token with public read is fine (can be the same FG-PAT). Used only for upstream skill checks.
GITHUB_TOKEN=

# --- Optional: pipeline behavior ------------------------------------------------------
# Model override for the agents (e.g. claude-sonnet-4.5). Leave blank for the CLI default.
COPILOT_MODEL=
# Optional per-phase model overrides (win over COPILOT_MODEL). Use a lighter model for the
# data/review passes and a capable one for the build pass to conserve quota, e.g.:
#   COPILOT_MODEL_DATA=claude-haiku-4.5
#   COPILOT_MODEL_BUILD=claude-sonnet-4.5
#   COPILOT_MODEL_REVIEW=claude-haiku-4.5
COPILOT_MODEL_DATA=
COPILOT_MODEL_BUILD=
COPILOT_MODEL_REVIEW=
# Skill update policy: check (notify only, default) | update (auto re-vendor)
SKILL_UPDATE_POLICY=check
# Phase toggles — set to 1 to skip a phase
SKIP_FETCH=0
SKIP_DATA=0
SKIP_BUILD=0
SKIP_REVIEW=0
# Always run the build + review agents, even when the deterministic gate already passes (1 = force)
FORCE_AGENTS=0
# Explicit source deck (default: the single .pptx in the repo root)
SOURCE_PPTX=
# Region scope for events/webinars — overrides config/sources.yaml events.scope_regions for this run.
# Comma-separated macro-regions, or GLOBAL for everywhere. Known: EMEA, MENA, APAC, AMERICAS
# (aliases: USA/US -> AMERICAS, EU -> EMEA, ASIA -> APAC). Examples:
#   EVENT_SCOPE=EMEA,MENA   (default — this is the CSE EMEA deck)
#   EVENT_SCOPE=GLOBAL      (no region filter)
#   EVENT_SCOPE=USA         (Americas only)
EVENT_SCOPE=

# --- Future: deliver the finished deck to OneDrive / Box (serverless; not yet wired) --
# Today's main workflow is the interactive, manual run with Copilot. Later, to auto-upload the
# produced deck on a schedule, fill in ONE provider below and we add the upload step after the
# review phase. App credentials (a registered app / service principal) are recommended for
# unattended runs. (Google Drive is intentionally NOT the target.)
# ONEDRIVE_FOLDER_ID=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=/run/secrets/onedrive_secret
# BOX_FOLDER_ID=
# BOX_JWT_CONFIG=/run/secrets/box_jwt.json
