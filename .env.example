# Copy to `.env` and fill in what you need. NEVER commit your real .env (it is gitignored).
# A plain `make build` on a laptop needs none of this.

# --- Weekly build -------------------------------------------------------------------------
# Region scope for events/webinars — overrides config/sources.yaml events.scope_regions for a run.
# Comma-separated macro-regions, or GLOBAL. Known: EMEA, MENA, APAC, AMERICAS
# (aliases: USA/US -> AMERICAS, EU -> EMEA, ASIA -> APAC).
EVENT_SCOPE=
# Reuse data/*.json from the last fetch (1) instead of fetching.
SKIP_FETCH=0
# Enrichment step: auto = run it when the opencode CLI is installed, 1 = always, 0 = never.
ENRICH=auto
# Model for the enrichment agent (provider/model as opencode knows it).
ENRICH_MODEL=ica-gateway/claude-haiku-5-5
# Fail the build (exit 50) when an optional source — the events page — was unreachable.
STRICT=0
# Pin "today" (YYYY-MM-DD) to reproduce a build from saved data.
# BUILD_DATE=

# --- Pipelines (ci/) ----------------------------------------------------------------------
# In IBM Secure Pipelines Service these are pipeline PROPERTIES, not variables (see
# docs/pipelines.md): `ica-api-key` is ICA_API_KEY, and so on. Set them here only to run ci/
# scripts outside a pipeline. On a laptop opencode uses its own stored login instead.
# ICA_BASE_URL=            # the LLM gateway's OpenAI-compatible base URL (ends in /v1)
# ICA_API_KEY=             # the gateway API key
# FIX_MODEL=ica-gateway/claude-sonnet-5-5  # model for the self-heal repair agent
# REVIEW_MODELS=ica-gateway/gpt-6.1-sol bob/premium  # the pull request review's models, in order
# REVIEW_MENTION=         # GitHub logins copied on each review
# BOB_API_KEY=            # IBM Bob "Inference" API key: the review's fallback
# GIT_TOKEN=               # GitHub token: publish releases, push state and repair branches, open PRs
# SELFHEAL_WEBHOOK_URL=    # the self-heal pipeline's generic-webhook trigger
# SELFHEAL_WEBHOOK_TOKEN=
# CI_DRY_RUN=1             # rehearse a pipeline: nothing is pushed, published or reported

# --- Legacy in-place updater (run.sh) -----------------------------------------------------
# Only for the old "patch a full customer deck" flow, which uses the GitHub Copilot CLI.
# COPILOT_GITHUB_TOKEN=
# COPILOT_MODEL=
# SOURCE_PPTX=
# SKILL_UPDATE_POLICY=check
